# Copy to .env to override defaults (optional — docker compose has safe defaults).
# Never commit a real .env.

# Backend
PORT=3000
# Product data source (swap the adapter + this URL to change provider)
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# Email (Mailpit locally; point at a real SMTP/SES endpoint in other environments)
SMTP_HOST=mailpit
SMTP_PORT=1025
SALES_INBOX=sales@example.com
ENQUIRY_FROM=no-reply@catalogue.local

# Abuse protection for POST /enquiries
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
