<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Catalogue" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: branded splash (AndroidX SplashScreen backports the Android 12 API to minSdk 24),
         then switches to the app theme. -->
    <style name="Theme.Catalogue.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Catalogue</item>
    </style>
</resources>
